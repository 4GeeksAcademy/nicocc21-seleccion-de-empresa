# =============================================================================
# Brasaland — Variables de Entorno
# =============================================================================
# Copia este archivo como .env y ajusta los valores según tu entorno.
#   cp .env.example .env
#
# NUNCA subas el archivo .env al repositorio. Está en .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend — FastAPI (services/api/)
# ---------------------------------------------------------------------------

# Clave secreta para firmar JWT. OBLIGATORIA en producción.
# Genera una con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia_esto_por_una_clave_segura

# Minutos de validez del token JWT (opcional, por defecto 60)
JWT_EXPIRE_MINUTES=60

# Puerto del servidor de incidencias (WSGI) (opcional, por defecto 8000)
# No se usa como variable de entorno, pero es el puerto por defecto en app.py

# ---------------------------------------------------------------------------
# Backend — Credenciales de seed (services/api/)
# ---------------------------------------------------------------------------

# Email y password para el usuario admin que se crea al hacer seed.
# Si no se definen, se usan los valores por defecto (SOLO para desarrollo local).
SEED_ADMIN_EMAIL=admin@brasaland.com
SEED_ADMIN_PASSWORD=Admin1234

# ---------------------------------------------------------------------------
# Frontend — Next.js (uis/backoffice/)
# ---------------------------------------------------------------------------

# URL base del backend de proveedores (FastAPI en services/api/)
SUPPLIERS_BACKEND_BASE_URL=http://127.0.0.1:8001

# URL base del backend de incidencias (WSGI en services/api/app.py)
INCIDENTS_BACKEND_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Frontend — Next.js (uis/application/)
# ---------------------------------------------------------------------------

# URL base del backend de proveedores (FastAPI en services/api/)
SUPPLIERS_BACKEND_BASE_URL=http://127.0.0.1:8001

# ---------------------------------------------------------------------------
# Frontend — Next.js (uis/talent-pipeline-tracker/)
# ---------------------------------------------------------------------------

# URL base de la API de candidates (expuesta al cliente)
NEXT_PUBLIC_API_URL=https://playground.4geeks.com/tracker/api/v1

# ---------------------------------------------------------------------------
# Frontend — Cliente de autenticación compartido (src/auth/)
# ---------------------------------------------------------------------------

# URL base de la API de autenticación (expuesta al cliente)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8001