# ──────────────────────────────────────────────
# Brasaland Backoffice — Next.js (frontend interno)
# ──────────────────────────────────────────────
# Copia este archivo como .env en uis/backoffice/
# o configúralo en el entorno de despliegue.
# ──────────────────────────────────────────────

# === URLs de backend (API upstream) ===
AUTH_BACKEND_BASE_URL=http://127.0.0.1:8001
INCIDENTS_BACKEND_BASE_URL=http://127.0.0.1:8001
INCIDENTS_ANALYZE_BACKEND_URL=http://127.0.0.1:8000
SUPPLIERS_BACKEND_BASE_URL=http://127.0.0.1:8001
INVENTORY_BACKEND_BASE_URL=http://127.0.0.1:8001

# === Captura de telemetria (URL publica, nunca incluir secretos) ===
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
NEXT_PUBLIC_APP_VERSION=0.1.0