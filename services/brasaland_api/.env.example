# Brasaland API — variables de entorno
# ==============================================
# Copia este archivo como .env y completa los valores.
# NUNCA subas .env al repositorio — ya está en .gitignore.

# JWT
JWT_SECRET_KEY=brasaland-dev-secret-change-in-production
JWT_EXPIRE_MINUTES=60

# Token de restablecimiento (minutos)
RESET_TOKEN_EXPIRE_MINUTES=15

# Resend (servicio de email transaccional)
# Regístrate en https://resend.com y crea una API key
RESEND_API_KEY=re_xxxxx
# URL del frontend (para generar enlaces de restablecimiento)
FRONTEND_URL=http://localhost:3000

# Hito 5 — Supabase (PostgreSQL) para el modulo de inventario
# ==============================================
# Panel de Supabase: Project Settings > Database > Connection string
# Elige "Transaction pooler" como metodo y "URI" como tipo (puerto 6543).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
